{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Something now waits far from spawn. Your compass knows where. Open it, and the world turns to glass around everything that was ever built. Server-side only.",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "https://github.com/BackupBackupFede/${mod_repo}",
    "issues": "https://github.com/BackupBackupFede/${mod_repo}/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.emeraude.clearness.fabric.ClearnessFabric"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "minecraft": "${fabric_mc_dep}",
    "fabricloader": ">=0.16"${fabric_api_dep}
  }
}
